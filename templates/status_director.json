{
  "lines": {
    "line-a": {"board": "board/STATUS.md", "match": "line-a", "repo": "../line-a", "results": "../line-a/out",
               "glob": "RESULT*.md", "log": "../line-a/run.log"}
  },
  "schema_version": 1,
  "name": "director",
  "po_page": {
    "path": "<WS>/DIRECTOR/PO_PENDING.md",
    "counts": [
      {"label": "decisions answered", "regex": "^STATUS:\\s*answered\\b"},
      {"label": "notes new", "regex": "^STATUS:\\s*new\\b"}
    ]
  },
  "orders": {"dir": "<WS>/DIRECTOR/orders", "glob": "WO-*.md", "show": 8},
  "pending_sends": {"path": "<WS>/DIRECTOR/PENDING_SENDS.md"},
  "audit": {"globs": ["<WS>/DIRECTOR/audit/*.jsonl"], "hours": 1},
  "processes": [{"label": "idle_watch", "match": "idle_watch"}],
  "disk": "<WS>",
  "disk_min_gib": 20,
  "max_lines": 60
}
